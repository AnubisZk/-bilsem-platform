# BİLSEM Platform Backend - Environment Variables
DATABASE_URL="postgresql://bilsem_user:bilsem_pass@localhost:5432/bilsem_db"
JWT_SECRET="bilsem-jwt-super-secret-key-change-in-production-2024"
PORT=3001
FRONTEND_URL="http://localhost:3000"

# Anthropic AI (Claude)
ANTHROPIC_API_KEY="sk-ant-your-key-here"

# Google Drive Integration
GDRIVE_CLIENT_ID="your-google-client-id"
GDRIVE_CLIENT_SECRET="your-google-client-secret"
GDRIVE_REDIRECT_URI="http://localhost:3001/api/gdrive/callback"
GDRIVE_ACTIVITIES_FOLDER_ID="your-gdrive-folder-id"

# File Storage (Supabase veya local)
STORAGE_TYPE="local"   # local | supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-key"
SUPABASE_BUCKET="bilsem-uploads"

# Upload Settings
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=52428800   # 50MB
